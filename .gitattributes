# Normalize text files
* text=auto

# Source code and configuration
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.http text eol=lf
*.sh text eol=lf

# Git configuration files
.gitignore text eol=lf
.gitattributes text eol=lf

# Maven Wrapper
/mvnw text eol=lf
*.cmd text eol=crlf
